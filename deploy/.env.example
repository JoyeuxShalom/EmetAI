# Copy to deploy/.env on the server and fill in.
# Never commit the real file - it is in .gitignore.

# The address churches will visit. A free DuckDNS subdomain works:
#   emetai.duckdns.org
EMETAI_DOMAIN=

# Any long random string. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# 0 = Gemini ear only (right for a small cloud instance)
# 1 = also load the offline Whisper models (needs ~1 GB more RAM)
EMETAI_LOCAL_EARS=0
